# ---------------------------------------------------------------------------
# VisionBridge configuration
#
# Copy this file to `.env` in the repository root and fill in GEMMA_API_KEY.
# ---------------------------------------------------------------------------

# --- Gemma (the ONLY generative model allowed in this project) --------------
# Get a free key at https://aistudio.google.com/apikey
GEMMA_API_KEY=

# Model id. Must start with "gemma" — startup validation refuses anything else.
# Competition build: pinned to a verified Gemma 4 id. Use "auto" to let
# VisionBridge pick the newest Gemma vision model your key can see instead.
GEMMA_MODEL=gemma-4-31b-it

# Ordered preference list used when GEMMA_MODEL=auto, or as the fallback when the
# pinned model is unavailable to this key. Comma separated, best first.
#
# Gemma 4 (April 2026) serves two multimodal ids through the Gemini API:
#   gemma-4-31b-it      dense 31B  — most capable, the pinned default
#   gemma-4-26b-a4b-it  MoE, 4B active — faster/cheaper per frame; the fallback
# No Gemma 3 in the competition build — the fallback is another Gemma 4 model.
GEMMA_MODEL_PREFERENCES=gemma-4-31b-it,gemma-4-26b-a4b-it

GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT_MS=90000
GEMMA_MAX_RETRIES=2

# --- Fallback: a second Google AI Studio key (optional) ---------------------
# Used only if the primary key fails or is rate-limited — same endpoint, same
# Gemma model, but a separate free-tier quota (use a different Google account).
# Leave blank to disable. Get a key at https://aistudio.google.com/apikey
GEMMA_API_KEY_FALLBACK=

# --- Server -----------------------------------------------------------------
PORT=5174
LOG_LEVEL=info
CACHE_DIR=.cache
# Comma-separated list of origins allowed to call the API. In a split
# deployment this must include the static client's origin, e.g.
# https://visionbridge.vercel.app
CORS_ORIGIN=http://localhost:5173

# --- Client (build-time, Vite) ----------------------------------------------
# Origin of the API server. Leave blank for local dev and for `npm start`,
# where the client is served by the API itself and relative paths work. Set it
# only when the client is hosted separately from the server, e.g.
# https://api.example.com
# NOTE: anything prefixed VITE_ is inlined into the public JS bundle. Never put
# an API key here — the Gemma key belongs on the server only.
VITE_API_BASE=

# --- External binaries ------------------------------------------------------
# Leave blank to auto-discover on PATH and in the usual install locations.
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Netscape-format cookies.txt for yt-dlp. Required on most cloud/datacenter
# hosts, where YouTube blocks anonymous requests with "Sign in to confirm
# you're not a bot". Export from a browser logged into a throwaway Google
# account (never your primary one — this file is a live session credential).
# Leave blank on a residential connection, where it is usually not needed.
YTDLP_COOKIES_PATH=

# A directory of cookies.txt files (one per throwaway account), e.g.
# cookies/cookies-1.txt, cookies/cookies-2.txt, ... — tried in rotation.
# YouTube revokes a session on its own schedule, not the file's stated
# expiry, so a datacenter host can burn through one in days. A file that
# gets bot-checked is skipped for a cooldown and the next one is used
# automatically, no restart needed. Takes priority over YTDLP_COOKIES_PATH.
YTDLP_COOKIES_DIR=

# --- Pipeline tuning --------------------------------------------------------
# A silence shorter than this is not long enough to speak into.
MIN_GAP_SECONDS=1.2
# Never place two candidate descriptions closer together than this.
MIN_SPACING_SECONDS=8
# If narration never pauses, force a candidate this often (Extended AD).
FORCED_CANDIDATE_INTERVAL=45
# Hard ceiling on Gemma calls per video.
MAX_CANDIDATES=60
# Concurrent Gemma requests during batch description.
GEMMA_CONCURRENCY=3

# --- Confidence rules (section 11 of the spec) ------------------------------
# >= HIGH            -> speak normally
# CRITICAL..HIGH     -> speak only when the visual information is critical
# < CRITICAL         -> discard (silence beats a wrong description)
CONFIDENCE_HIGH=0.85
CONFIDENCE_CRITICAL=0.6

# --- Frames -----------------------------------------------------------------
FRAME_WIDTH=640
FRAME_QUALITY=5
MAX_VIDEO_HEIGHT=480

# --- Language ---------------------------------------------------------------
# VisionBridge is multilingual: it captions a lesson in the language it is
# actually taught in and, by default, describes and answers in that same
# language. English behaves exactly as before.
#
# Caption languages to fetch. "auto" (default) reads the video's own available
# tracks — a Bengali tutorial gets Bengali captions, an English one English.
# Set an explicit comma list (best first) to force a preference, e.g. "bn,en".
CAPTION_LANGS=auto
# The language descriptions and answers are written and spoken in. "auto"
# (default) mirrors the narration; a BCP-47 code forces one language regardless
# of the video, e.g. OUTPUT_LANG=bn to always describe in Bengali.
#
# Note: spoken output depends on the browser/OS having a voice for the language.
# Microsoft Edge exposes online voices for many languages (including Bengali);
# otherwise install the language's voice in your operating system settings.
OUTPUT_LANG=auto

# --- Voice search (optional) ------------------------------------------------
# Press W in the app to search YouTube by speaking. Speech is transcribed with
# Whisper — an Automatic Speech Recognition (ASR) model, a permitted *supporting*
# technology. It is NOT an LLM and generates no content, so Gemma remains the
# only generative model. Text search works without any of this; only *spoken*
# search needs a key.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
# Point at an OpenAI-compatible transcription endpoint if you self-host Whisper.
OPENAI_BASE_URL=https://api.openai.com/v1
# How many YouTube results a search returns.
SEARCH_MAX_RESULTS=6
