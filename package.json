{
  "name": "visionbridge",
  "version": "1.0.0",
  "private": true,
  "description": "Gemma-powered accessibility companion that adds context-aware audio descriptions to YouTube tutorials for blind and low-vision learners.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "doctor": "npm run doctor --workspace server",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
